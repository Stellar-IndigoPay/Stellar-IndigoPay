EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_STELLAR_NETWORK=testnet
EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Device-integrity policy for jailbreak/root detection: off | warn | block
EXPO_PUBLIC_DEVICE_INTEGRITY_POLICY=block
EXPO_PUBLIC_CONTRACT_ID=
EXPO_PUBLIC_USDC_ISSUER=
EXPO_PUBLIC_PROJECT_ID=

# ── Certificate / public-key pinning (see docs/mobile-pinning.md) ──────────
# Master switch. Set EXPO_PUBLIC_PINNING_ENABLED=false to disable pinning
# entirely (dev/test); leave unset (or true) to enable.
EXPO_PUBLIC_PINNING_ENABLED=false

# JSON mapping of hostname -> array of RFC 7469 SPKI pins (base64 SHA-256 of
# the DER-encoded SubjectPublicKeyInfo). At least one pin must match the peer
# certificate. Ship >= 2 pins (current + next) so rotation never locks users out.
# Generate with:
#   openssl s_client -connect api.example.com:443 -servername api.example.com \
#     </dev/null 2>/dev/null | openssl x509 -pubkey -noout | \
#     openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl base64
EXPO_PUBLIC_PINNING_POLICY={"api.example.com":["sha256/<base64>","sha256/<base64>"]}

# Comma-separated hosts that are exempt from pinning (dev allowlist).
# localhost/loopback are always exempt.
EXPO_PUBLIC_PIN_ALLOWLIST=

# HMAC-SHA256 secret authenticating remote pin updates applied at runtime via
# lib/pinning.ts applyRemotePinUpdate(). Keep it out of source control in
# production; an empty value disables remote pin updates.
EXPO_PUBLIC_PIN_UPDATE_SECRET=
